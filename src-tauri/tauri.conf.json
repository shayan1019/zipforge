{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zipforge",
  "version": "0.4.1",
  "identifier": "com.zipforge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "zipforge",
        "width": 1120,
        "height": 720,
        "minWidth": 920,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Fast, modern archive manager",
    "longDescription": "Open, create and extract zip, 7z, rar, tar, gz, iso, cab and jar archives with a fast native UI.",
    "windows": {
      "nsis": {
        "installerHooks": "./nsis/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
